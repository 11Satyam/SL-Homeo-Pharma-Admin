        {
          "name": "Create Collection",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Idempotency-Key", "value": "collection-unique-key-001", "description": "8-64 chars [A-Za-z0-9_-], unique per request" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shop_id\": 1,\n  \"amount\": \"500.00\",\n  \"method\": \"cash\",\n  \"reference\": null,\n  \"remarks\": \"Monthly collection\",\n  \"collected_at\": \"2025-01-01T10:00:00+05:30\",\n  \"allocations\": [\n    { \"invoice_id\": 1, \"amount\": \"500.00\" }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/app/collections", "host": ["{{base_url}}"], "path": ["api", "app", "collections"] },
            "description": "method: cash | upi | bank_transfer | cheque | other\nreference is required for upi, bank_transfer, cheque"
          }
        }
      ]
    },
