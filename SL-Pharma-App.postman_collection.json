    {
      "name": "Expenses",
      "item": [
        {
          "name": "List Expenses",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/app/expenses?status=&from=&to=&per_page=20",
              "host": ["{{base_url}}"],
              "path": ["api", "app", "expenses"],
              "query": [
                { "key": "status", "value": "", "description": "submitted | approved | rejected" },
                { "key": "from", "value": "", "description": "YYYY-MM-DD" },
                { "key": "to", "value": "", "description": "YYYY-MM-DD" },
                { "key": "per_page", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Submit Expense (JSON)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Idempotency-Key", "value": "expense-unique-key-001", "description": "8-64 chars [A-Za-z0-9_-], unique per request" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"travel\",\n  \"amount\": \"150.00\",\n  \"expense_date\": \"2025-01-01\",\n  \"description\": \"Auto fare to market\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/app/expenses", "host": ["{{base_url}}"], "path": ["api", "app", "expenses"] },
            "description": "description is required when category = other"
          }
        },
        {
          "name": "Submit Expense (With Receipt)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Idempotency-Key", "value": "expense-unique-key-002" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "category", "value": "travel", "type": "text" },
                { "key": "amount", "value": "150.00", "type": "text" },
                { "key": "expense_date", "value": "2025-01-01", "type": "text" },
                { "key": "description", "value": "Auto fare", "type": "text" },
                { "key": "receipt", "type": "file", "src": "", "description": "jpg, jpeg, png or pdf" }
              ]
            },
            "url": { "raw": "{{base_url}}/api/app/expenses", "host": ["{{base_url}}"], "path": ["api", "app", "expenses"] }
          }
        }
