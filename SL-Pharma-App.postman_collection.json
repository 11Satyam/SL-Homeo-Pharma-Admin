              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/app/products?search=&category=&in_stock=&per_page=50",
              "host": ["{{base_url}}"],
              "path": ["api", "app", "products"],
              "query": [
                { "key": "search", "value": "", "description": "Search by name or SKU" },
                { "key": "category", "value": "", "description": "Filter by category" },
                { "key": "in_stock", "value": "", "description": "true = only in-stock items" },
                { "key": "per_page", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "Get Single Product",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/app/products/1",
              "host": ["{{base_url}}"],
              "path": ["api", "app", "products", "1"],
              "description": "Replace 1 with actual product ID"
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/app/orders?status=&shop_id=&search=&from=&to=&per_page=20",
              "host": ["{{base_url}}"],
              "path": ["api", "app", "orders"],
              "query": [
                { "key": "status", "value": "", "description": "e.g. pending, confirmed, packed, out_for_delivery, delivered, cancelled" },
                { "key": "shop_id", "value": "" },
                { "key": "search", "value": "", "description": "Search by order number" },
                { "key": "from", "value": "", "description": "Date filter YYYY-MM-DD" },
                { "key": "to", "value": "", "description": "Date filter YYYY-MM-DD" },
                { "key": "per_page", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Single Order",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/app/orders/1",
              "host": ["{{base_url}}"],
              "path": ["api", "app", "orders", "1"]
            }
          }
        },
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Idempotency-Key", "value": "order-unique-key-001", "description": "8-64 chars [A-Za-z0-9_-], unique per request" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shop_id\": 1,\n  \"items\": [\n    { \"product_id\": 1, \"qty\": 10 },\n    { \"product_id\": 2, \"qty\": 5 }\n  ],\n  \"remarks\": \"Urgent delivery\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/app/orders", "host": ["{{base_url}}"], "path": ["api", "app", "orders"] }
          }
        }
      ]
    },
    {
      "name": "Cart",
      "description": "One cart per staff member per shop. Set the collection variables shop_id and product_id first. Prices, GST and stock are recalculated live on every response.",
      "item": [
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/app/cart?shop_id={{shop_id}}", "host": ["{{base_url}}"], "path": ["api", "app", "cart"], "query": [{ "key": "shop_id", "value": "{{shop_id}}" }] }
          }
        },
        {
          "name": "List Open Carts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/app/carts", "host": ["{{base_url}}"], "path": ["api", "app", "carts"] }
          }
        },
        {
          "name": "Add To Cart",
          "request": {
            "method": "POST",
            "description": "If the product is already in the cart, the quantities are combined (no duplicate line).",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shop_id\": {{shop_id}},\n  \"product_id\": {{product_id}},\n  \"qty\": 3\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/app/cart/items", "host": ["{{base_url}}"], "path": ["api", "app", "cart", "items"] }
          }
        },
        {
          "name": "Update Cart Item Quantity",
          "request": {
            "method": "PATCH",
            "description": "Sets the exact quantity. qty 0 removes the line.",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shop_id\": {{shop_id}},\n  \"qty\": 7\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/app/cart/items/{{product_id}}", "host": ["{{base_url}}"], "path": ["api", "app", "cart", "items", "{{product_id}}"] }
          }
        },
        {
          "name": "Remove Cart Item",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/app/cart/items/{{product_id}}?shop_id={{shop_id}}", "host": ["{{base_url}}"], "path": ["api", "app", "cart", "items", "{{product_id}}"], "query": [{ "key": "shop_id", "value": "{{shop_id}}" }] }
          }
        },
        {
          "name": "Clear Cart",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/app/cart?shop_id={{shop_id}}", "host": ["{{base_url}}"], "path": ["api", "app", "cart"], "query": [{ "key": "shop_id", "value": "{{shop_id}}" }] }
          }
        },
        {
          "name": "Checkout Cart (Place Order)",
          "request": {
            "method": "POST",
            "description": "Creates a confirmed order and empties the cart. {{$guid}} sends a new Idempotency-Key each run; to test retry safety, replace it with a fixed value and send twice.",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shop_id\": {{shop_id}},\n  \"remarks\": \"Deliver before 11 AM\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/app/cart/checkout", "host": ["{{base_url}}"], "path": ["api", "app", "cart", "checkout"] }
          }
        }
      ]
    },
    {
