              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/app/parties?search=&area=&per_page=50",
              "host": ["{{base_url}}"],
              "path": ["api", "app", "parties"],
              "query": [
                { "key": "search", "value": "", "description": "Search by name, owner, phone" },
                { "key": "area", "value": "", "description": "Filter by area" },
                { "key": "per_page", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "Get Party Invoices",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/app/parties/1/invoices",
              "host": ["{{base_url}}"],
              "path": ["api", "app", "parties", "1", "invoices"],
              "description": "Replace 1 with actual shop ID"
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List Products",
          "request": {
