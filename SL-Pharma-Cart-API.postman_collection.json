{
    "info": {
        "name": "SL Pharma - Add To Cart API",
        "_postman_id": "sl-pharma-cart-api-collection",
        "description": "Field staff app cart APIs (/api/app/cart). 1) Run a Login request (token is saved automatically). 2) Set shop_id and product_id in the collection Variables. 3) Add To Cart -> Get Cart -> Checkout. One cart per staff member per shop; prices, GST and stock are recalculated live on every response.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "https://slhomeopharma.com",
            "type": "string"
        },
        {
            "key": "token",
            "value": "",
            "type": "string"
        },
        {
            "key": "shop_id",
            "value": "1",
            "type": "string"
        },
        {
            "key": "product_id",
            "value": "1",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "1. Login (saves token)",
            "item": [
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var res = pm.response.json();",
                                    "if (res.data && res.data.token) {",
                                    "  pm.collectionVariables.set('token', res.data.token);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"staff@example.com\",\n  \"password\": \"password\",\n  \"device_name\": \"postman\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/app/auth/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "app",
                                "auth",
                                "login"
                            ]
                        }
                    }
                },
                {
                    "name": "Login (Mobile + Password)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var res = pm.response.json();",
                                    "if (res.data && res.data.token) {",
                                    "  pm.collectionVariables.set('token', res.data.token);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"mobile\": \"9819001101\",\n  \"password\": \"Demo@12345\",\n  \"device_name\": \"postman\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/app/auth/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "app",
                                "auth",
                                "login"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "2. Cart",
            "description": "One cart per staff member per shop. Set the collection variables shop_id and product_id first. Prices, GST and stock are recalculated live on every response.",
            "item": [
                {
                    "name": "Get Cart",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/app/cart?shop_id={{shop_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "app",
                                "cart"
                            ],
                            "query": [
                                {
                                    "key": "shop_id",
                                    "value": "{{shop_id}}"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "List Open Carts",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/app/carts",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "app",
                                "carts"
                            ]
                        }
                    }
                },
                {
                    "name": "Add To Cart",
                    "request": {
                        "method": "POST",
                        "description": "If the product is already in the cart, the quantities are combined (no duplicate line).",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"shop_id\": {{shop_id}},\n  \"product_id\": {{product_id}},\n  \"qty\": 3\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/app/cart/items",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "app",
                                "cart",
                                "items"
                            ]
                        }
                    }
                },
                {
                    "name": "Update Cart Item Quantity",
                    "request": {
                        "method": "PATCH",
                        "description": "Sets the exact quantity. qty 0 removes the line.",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"shop_id\": {{shop_id}},\n  \"qty\": 7\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/app/cart/items/{{product_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "app",
                                "cart",
                                "items",
                                "{{product_id}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Remove Cart Item",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/app/cart/items/{{product_id}}?shop_id={{shop_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "app",
                                "cart",
                                "items",
                                "{{product_id}}"
                            ],
                            "query": [
                                {
                                    "key": "shop_id",
                                    "value": "{{shop_id}}"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Clear Cart",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/app/cart?shop_id={{shop_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "app",
                                "cart"
                            ],
                            "query": [
                                {
                                    "key": "shop_id",
                                    "value": "{{shop_id}}"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Checkout Cart (Place Order)",
                    "request": {
                        "method": "POST",
                        "description": "Creates a confirmed order and empties the cart. {{$guid}} sends a new Idempotency-Key each run; to test retry safety, replace it with a fixed value and send twice.",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Idempotency-Key",
                                "value": "{{$guid}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"shop_id\": {{shop_id}},\n  \"remarks\": \"Deliver before 11 AM\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/app/cart/checkout",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "app",
                                "cart",
                                "checkout"
                            ]
                        }
                    }
                }
            ]
        }
    ]
}
